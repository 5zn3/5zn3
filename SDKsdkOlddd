-- ========== ПОИСК ВРАГА ДЛЯ AUTO BAT ==========
local function findNearestEnemy()
    local hrp = getHRP()
    if not hrp then return nil end
    local nearest, nearestDist = nil, 300
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local targetHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if targetHrp and hum and hum.Health > 0 then
                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = targetHrp
                end
            end
        end
    end
    return nearest, nearestDist
end

local function findBat()
    local char = player.Character
    if not char then return nil end
    for _, ch in ipairs(char:GetChildren()) do
        if ch:IsA("Tool") and (ch.Name:lower():find("bat") or ch.Name:lower():find("slap")) then
            return ch
        end
    end
    local bp = player:FindFirstChildOfClass("Backpack")
    if bp then
        for _, ch in ipairs(bp:GetChildren()) do
            if ch:IsA("Tool") and (ch.Name:lower():find("bat") or ch.Name:lower():find("slap")) then
                return ch
            end
        end
    end
    return nil
end

local function startAutoBat()
    if autoBatConn then autoBatConn:Disconnect() end
    autoBatConn = RunService.Heartbeat:Connect(function()
        if not autoBatEnabled then return end
        local char = player.Character
        if not char then return end
        local hrp = getHRP()
        local hum = getHum()
        if not hrp or not hum then return end
        local target, dist = findNearestEnemy()
        if target then
            local dir = (target.Position - hrp.Position).Unit
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            hum:Move(flatDir, false)
            if dist > 2.5 then
                hrp.AssemblyLinearVelocity = Vector3.new(flatDir.X * 55, hrp.Velocity.Y, flatDir.Z * 55)
            else
                hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.Velocity.Y, 0)
                local bat = findBat()
                if bat and bat.Parent == char and dist <= 4 then
                    pcall(function() bat:Activate() end)
                end
            end
        end
    end)
end

local function stopAutoBat()
    if autoBatConn then autoBatConn:Disconnect(); autoBatConn = nil end
end

-- ========== AUTO STEAL ЧЕРЕЗ GETCONNECTIONS ==========
local autoStealEnabled = true
local isStealing = false
local autoStealConn = nil
local promptCache = {}
local callbackCache = {}

local function getPromptCallbacks(prompt)
    if callbackCache[prompt] then
        return callbackCache[prompt].holdCallbacks, callbackCache[prompt].triggerCallbacks
    end
    
    local holdCallbacks = {}
    local triggerCallbacks = {}
    
    local success1, connections1 = pcall(getconnections, prompt.PromptButtonHoldBegan)
    if success1 and type(connections1) == "table" then
        for _, conn in ipairs(connections1) do
            if type(conn.Function) == "function" then
                table.insert(holdCallbacks, conn.Function)
            end
        end
    end
    
    local success2, connections2 = pcall(getconnections, prompt.Triggered)
    if success2 and type(connections2) == "table" then
        for _, conn in ipairs(connections2) do
            if type(conn.Function) == "function" then
                table.insert(triggerCallbacks, conn.Function)
            end
        end
    end
    
    callbackCache[prompt] = {
        holdCallbacks = holdCallbacks,
        triggerCallbacks = triggerCallbacks
    }
    
    return holdCallbacks, triggerCallbacks
end

local function executeStealWithCallbacks(prompt)
    if not prompt or not prompt.Parent then return false end
    if isStealing then return false end
    
    local holdCallbacks, triggerCallbacks = getPromptCallbacks(prompt)
    
    isStealing = true
    
    task.spawn(function()
        for _, callback in ipairs(holdCallbacks) do
            task.spawn(callback)
        end
        
        task.wait(1.3)
        
        for _, callback in ipairs(triggerCallbacks) do
            task.spawn(callback)
        end
        
        task.wait(0.1)
        isStealing = false
    end)
    
    return true
end

local function findStealPrompt()
    local hrp = getHRP()
    if not hrp then return nil end
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, plot in pairs(plots:GetChildren()) do
        if not plot:IsA("Model") then continue end
        
        local sign = plot:FindFirstChild("PlotSign")
        local isMyBase = false
        if sign then
            local yourBase = sign:FindFirstChild("YourBase")
            if yourBase and yourBase:IsA("BillboardGui") then
                isMyBase = yourBase.Enabled == true
            end
        end
        if isMyBase then continue end
        
        local pods = plot:FindFirstChild("AnimalPodiums")
        if not pods then continue end
        for _, pod in pairs(pods:GetChildren()) do
            local base = pod:FindFirstChild("Base")
            local spawn = base and base:FindFirstChild("Spawn")
            if spawn then
                local att = spawn:FindFirstChild("PromptAttachment")
                if att then
                    for _, prompt in pairs(att:GetChildren()) do
                        if prompt:IsA("ProximityPrompt") and prompt.Enabled and prompt.ActionText == "Steal" then
                            local dist = (hrp.Position - spawn.Position).Magnitude
                            if dist < nearestDist and dist <= 20 then
                                nearestDist = dist
                                nearest = prompt
                            end
                        end
                    end
                end
            end
        end
    end
    return nearest
end

local function executeSteal()
    if isStealing then return end
    local prompt = findStealPrompt()
    if not prompt then return end
    
    if not promptCache[prompt] then
        promptCache[prompt] = true
    end
    
    executeStealWithCallbacks(prompt)
end

local function startAutoSteal()
    if autoStealConn then autoStealConn:Disconnect() end
    autoStealConn = RunService.Heartbeat:Connect(function()
        if not autoStealEnabled then return end
        if isStealing then return end
        executeSteal()
    end)
end

local function stopAutoSteal()
    if autoStealConn then autoStealConn:Disconnect(); autoStealConn = nil end
end

-- ========== КРАЖА ВО ВРЕМЯ ОЖИДАНИЯ (ДЛЯ АВТО-ЛЕВО/ПРАВО) ==========
local function executeStealWhileWaiting()
    if isStealing then return end
    local prompt = findStealPrompt()
    if not prompt then return end
    
    if not promptCache[prompt] then
        promptCache[prompt] = true
    end
    
    executeStealWithCallbacks(prompt)
end

-- ========== АВТО-ЛЕВО ==========
local function startAutoLeft()
    if autoLeftConn then autoLeftConn:Disconnect() end
    local phase = 1
    autoLeftConn = RunService.Heartbeat:Connect(function()
        if not autoLeftEnabled then return end
        local hrp = getHRP()
        local hum = getHum()
        if not hrp or not hum then return end
        
        if WAITING and WAIT_SIDE == "LEFT" then
            if tick() - WAIT_START >= WAIT_DUR then
                WAITING = false
                WAIT_SIDE = ""
                phase = 4
            end
            return
        end
        
        if phase == 1 then
            local dist = (L_START - hrp.Position).Magnitude
            if dist < 2.5 then 
                phase = 2 
            else 
                moveToPoint(L_START, 59)
            end
        elseif phase == 2 then
            local dist = (L_END - hrp.Position).Magnitude
            if dist < 2.5 then 
                WAITING = true
                WAIT_START = tick()
                WAIT_SIDE = "LEFT"
                phase = 3
                hum.WalkSpeed = 59
                hum:MoveTo(hrp.Position)
                executeStealWhileWaiting()
            else 
                moveToPoint(L_END, 29)
            end
        elseif phase == 3 then
            -- Ожидание 1.3 секунды
        elseif phase == 4 then
            local dist = (L_BACK - hrp.Position).Magnitude
            if dist < 2.5 then 
                phase = 5 
            else 
                moveToPoint(L_BACK, 29)
            end
        elseif phase == 5 then
            local dist = (L_RETURN - hrp.Position).Magnitude
            if dist < 2.5 then 
                phase = 6 
            else 
                moveToPoint(L_RETURN, 29)
            end
        elseif phase == 6 then
            local dist = (L_FINAL - hrp.Position).Magnitude
            if dist < 2.5 then 
                autoLeftEnabled = false
                phase = 1
                if autoLeftConn then autoLeftConn:Disconnect(); autoLeftConn = nil end
                hum.WalkSpeed = 59
                -- Обновляем toggle в GUI
                for _, row in pairs(content:GetChildren()) do
                    if row:IsA("Frame") then
