-- ========== DROP ==========
local function doDrop()
    if dropActive then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    dropActive = true
    local startTime = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local r = getHRP()
        if not r then conn:Disconnect(); dropActive = false; return end
        if tick() - startTime >= 0.4 then
            conn:Disconnect()
            local ray = workspace:Raycast(r.Position, Vector3.new(0, -1000, 0))
            if ray then
                local hum = getHum()
                local off = (hum and hum.HipHeight or 2) + (r.Size.Y / 2)
                r.CFrame = CFrame.new(r.Position.X, ray.Position.Y + off, r.Position.Z)
                r.Velocity = Vector3.zero
            end
            dropActive = false
            return
        end
        r.Velocity = Vector3.new(r.Velocity.X, 100, r.Velocity.Z)
    end)
end

local function teleportDown()
    task.spawn(function()
        local hrp = getHRP()
        if not hrp then return end
        local ray = workspace:Raycast(hrp.Position + Vector3.new(0, 2, 0), Vector3.new(0, -1000, 0))
        if ray then
            local hum = getHum()
            local off = (hum and hum.HipHeight or 2) + (hrp.Size.Y / 2)
            hrp.CFrame = CFrame.new(hrp.Position.X, ray.Position.Y + off, hrp.Position.Z)
            hrp.Velocity = Vector3.zero
        end
    end)
end

