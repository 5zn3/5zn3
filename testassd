local function buildCircleButtons()
    local C = CONFIG.Colors
    local gui = Instance.new("ScreenGui")
    gui.Name = CONFIG.Names.BtnGui
    gui.ResetOnSpawn = false
    pcall(function() gui.IgnoreGuiInset = true end)
    pcall(function() gui.Parent = game:GetService("CoreGui") end)
    if not gui.Parent then gui.Parent = LocalPlayer.PlayerGui end
    BtnGui = gui

    local SZ = CONFIG.Size.BtnSize
    local DARK = C.BtnInactive
    local BLUE = C.ActiveMode
    local BLUEON = C.RowStrokeOn
    local WHITE = C.Text
    local ACTIVE = C.BtnActive
    local KILL = C.KillColor

    local defs = {
        {label="CARRY\nSPD", key="carry", pos=UDim2.new(1,-210,0,80), hasKill=true},
        {label="LAGGER", key="lagger", pos=UDim2.new(1,-310,0,80), hasKill=true},
        {label="BAT\nAIMBOT", key="bat", pos=UDim2.new(1,-410,0,80), hasKill=false},
        {label="AUTO\nTP", key="autoTP", pos=UDim2.new(1,-210,0,190), hasKill=true},
        {label="TP\nDOWN", key="tpDown", pos=UDim2.new(1,-310,0,190), hasKill=false},
        {label="INSTA\nRESET", key="instaReset", pos=UDim2.new(1,-410,0,190), hasKill=false},
    }

    for _, def in ipairs(defs) do
        local btn = Instance.new("TextButton", gui)
        btn.Size = UDim2.new(0, SZ, 0, SZ)
        btn.Position = def.pos
        btn.BackgroundColor3 = DARK
        btn.BorderSizePixel = 0
        btn.Text = def.label
        btn.TextColor3 = WHITE
        btn.Font = Enum.Font.GothamBlack
        btn.TextSize = 13
        btn.TextWrapped = true
        btn.AutoButtonColor = false
        btn.ZIndex = 12

        local corner = Instance.new("UICorner", btn)
        corner.CornerRadius = UDim.new(1, 0)

        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = BLUE
        stroke.Thickness = 3
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

        local killDot = nil
        if def.hasKill then
            killDot = Instance.new("Frame", btn)
            killDot.Name = "KillDot"
            killDot.ZIndex = 14
            killDot.Size = UDim2.new(0, 14, 0, 14)
            killDot.Position = UDim2.new(1, -16, 0, 2)
            killDot.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            killDot.BorderSizePixel = 0
            Instance.new("UICorner", killDot).CornerRadius = UDim.new(1, 0)
            local killBtn = Instance.new("TextButton", killDot)
            killBtn.Size = UDim2.new(1, 0, 1, 0)
            killBtn.BackgroundTransparency = 1
            killBtn.Text = "✕"
            killBtn.TextColor3 = Color3.fromRGB(160, 160, 160)
            killBtn.TextSize = 9
            killBtn.Font = Enum.Font.GothamBold
            killBtn.ZIndex = 15
            killBtn.AutoButtonColor = false
            killBtn.MouseButton1Click:Connect(function()
                if def.key == "carry" then
                    if speedMode then toggleCarryMode() end
                    if _btnRefs["carry"] then _btnRefs["carry"].setOn(false) end
                elseif def.key == "lagger" then
                    if laggerToggled then
                        laggerToggled = false
                        laggerPhase = 0
                        if _btnRefs["lagger"] then _btnRefs["lagger"].setOn(false) end
                    end
                elseif def.key == "autoTP" then
                    autoTPEnabled = false
                    stopAutoTP()
                    if _btnRefs["autoTP"] then _btnRefs["autoTP"].setOn(false) end
                    if setAutoTPVisual then setAutoTPVisual(false) end
                end
                saveConfig()
            end)
        end

        local state = false
        local function setOn(on)
            state = on
            TweenService:Create(btn, TweenInfo.new(0.12), {
                BackgroundColor3 = on and ACTIVE or DARK
            }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.12), {
                Color = on and BLUEON or BLUE,
                Thickness = on and 5 or 3
            }):Play()
            if killDot then
                killDot.BackgroundColor3 = on and KILL or Color3.fromRGB(60, 60, 60)
            end
        end

        _btnRefs[def.key] = {setOn = setOn, getState = function() return state end}

        if _btnPositions[def.key] then
            local p = _btnPositions[def.key]
            btn.Position = UDim2.new(0, p.x, 0, p.y)
        end

        local dragging = false
        local dragStart = nil
        local startPos = nil

        btn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = inp.Position
                startPos = btn.Position
                inp.Changed:Connect(function()
                    if inp.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            if inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch then
                local dx = inp.Position.X - dragStart.X
                local dy = inp.Position.Y - dragStart.Y
                local newX = startPos.X.Offset + dx
                local newY = startPos.Y.Offset + dy
                btn.Position = UDim2.new(0, newX, 0, newY)
            end
        end)

        btn.InputEnded:Connect(function(inp)
            if inp.UserInputType ~= Enum.UserInputType.MouseButton1
            and inp.UserInputType ~= Enum.UserInputType.Touch then return end
            _btnPositions[def.key] = {x = btn.Position.X.Offset, y = btn.Position.Y.Offset}
            saveConfig()
        end)

        btn.MouseButton1Click:Connect(function()
            if def.key == "carry" then
                toggleCarryMode()
                saveConfig()
            elseif def.key == "lagger" then
                toggleLaggerMode()
                saveConfig()
            elseif def.key == "bat" then
                if autoBatEnabled then
                    disableAutoBat()
                    if autoBatSetVisual then autoBatSetVisual(false) end
                else
                    enableAutoBat()
                    if autoBatSetVisual then autoBatSetVisual(true) end
                end
            elseif def.key == "autoTP" then
                autoTPEnabled = not autoTPEnabled
                if autoTPEnabled then startAutoTP() else stopAutoTP() end
                if _btnRefs["autoTP"] then _btnRefs["autoTP"].setOn(autoTPEnabled) end
                if setAutoTPVisual then setAutoTPVisual(autoTPEnabled) end
                saveConfig()
            elseif def.key == "tpDown" then
                runTPFloor()
            elseif def.key == "instaReset" then
                cursedInstaReset()
            end
        end)
    end
end

