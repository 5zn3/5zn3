local function setButtonState(button, state)
    if state then
        button.Text = "ON"
        button.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    else
        button.Text = "OFF"
        button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    end
end

-- ============================================================
-- 1. INSTANT GRAB (ProximityPrompt)
-- ============================================================
local InstantGrabEnabled = false
local promptConnections = {}

local function hookPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        prompt.HoldDuration = 0
    end
end

local function scanPrompts()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            hookPrompt(obj)
        end
    end
end

local function toggleInstantGrab()
    InstantGrabEnabled = not InstantGrabEnabled
    setButtonState(InstantGrabBtn, InstantGrabEnabled)

    if InstantGrabEnabled then
        scanPrompts()

        promptConnections.newPrompt = workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ProximityPrompt") then
                hookPrompt(obj)
            end
        end)

        promptConnections.service = ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
            if InstantGrabEnabled then
                prompt.HoldDuration = 0
            end
        end)
    else
        if promptConnections.newPrompt then
            promptConnections.newPrompt:Disconnect()
            promptConnections.newPrompt = nil
        end
        if promptConnections.service then
            promptConnections.service:Disconnect()
            promptConnections.service = nil
        end
    end
end

InstantGrabBtn.MouseButton1Click:Connect(toggleInstantGrab)

-- ============================================================
-- 2. SPEED CHANGER (LinearVelocity + Attachment = 210) ✅
-- ============================================================
local SpeedEnabled = false
local SPEED_VALUE = 210
local speedAttachment = nil
local speedConstraint = nil

local function cleanupSpeed()
    if speedConstraint then
        speedConstraint:Destroy()
        speedConstraint = nil
    end
    if speedAttachment then
        speedAttachment:Destroy()
        speedAttachment = nil
    end
end

local function setupSpeed()
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Чистим старое, если было
    cleanupSpeed()

    -- Создаём Attachment внутри HumanoidRootPart
    speedAttachment = Instance.new("Attachment")
    speedAttachment.Name = "BlackHub_SpeedAttachment"
    speedAttachment.Parent = hrp

    -- Создаём LinearVelocity constraint
    speedConstraint = Instance.new("LinearVelocity")
    speedConstraint.Name = "BlackHub_LinearVelocity"
    speedConstraint.Attachment0 = speedAttachment
    speedConstraint.MaxForce = math.huge -- без ограничения силы
    speedConstraint.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    speedConstraint.ForceLimitMode = Enum.ForceLimitMode.PerAxis
    speedConstraint.MaxAxesForce = Vector3.new(math.huge, 0, math.huge) -- только X/Z, не Y
    speedConstraint.RelativeTo = Enum.ActuatorRelativeTo.World

    -- Направление берём из текущего движения игрока
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then
        local moveDir = humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            speedConstraint.VectorVelocity = moveDir.Unit * SPEED_VALUE
        else
            -- если стоим — задаём по направлению взгляда
            local look = hrp.CFrame.LookVector
            speedConstraint.VectorVelocity = Vector3.new(look.X, 0, look.Z).Unit * SPEED_VALUE
        end
    end

    speedConstraint.Parent = hrp
end

local function updateSpeedDirection()
    if not speedConstraint then return end
    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end

    local moveDir = humanoid.MoveDirection
    if moveDir.Magnitude > 0 then
        speedConstraint.VectorVelocity = moveDir.Unit * SPEED_VALUE
    else
        local look = hrp.CFrame.LookVector
        speedConstraint.VectorVelocity = Vector3.new(look.X, 0, look.Z).Unit * SPEED_VALUE
    end
end

local speedUpdateConn = nil

local function toggleSpeed()
    SpeedEnabled = not SpeedEnabled
    setButtonState(SpeedChangerBtn, SpeedEnabled)

    if SpeedEnabled then
        setupSpeed()

        -- Обновляем направление каждый кадр (чтобы игрок мог рулить)
        speedUpdateConn = RunService.Heartbeat:Connect(updateSpeedDirection)

        -- Если персонаж умрёт/респавнится — пересоздаём
        LocalPlayer.CharacterAdded:Connect(function()
            if SpeedEnabled then
                task.wait(0.5)
                setupSpeed()
            end
        end)
    else
        if speedUpdateConn then
            speedUpdateConn:Disconnect()
            speedUpdateConn = nil
        end
        cleanupSpeed()
    end
end

SpeedChangerBtn.MouseButton1Click:Connect(toggleSpeed)

-- ============================================================
-- 3. ESP FUNCTION (белая подсветка игроков)
-- ============================================================
local EspEnabled = false
local highlights = {}
local espConnections = {}

local function createHighlight(character)
    if not character or character:FindFirstChild("BlackHub_ESP") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "BlackHub_ESP"
    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = character
    highlight.Parent = character

    highlights[character] = highlight
end

local function removeHighlight(character)
    if highlights[character] then
        highlights[character]:Destroy()
        highlights[character] = nil
    end
end

local function setupPlayer(player)
    if player == LocalPlayer then return end

    if player.Character then
        createHighlight(player.Character)
    end

    espConnections[player] = player.CharacterAdded:Connect(function(char)
        if EspEnabled then
            task.wait(0.3)
            createHighlight(char)
        end
    end)
end

local function toggleEsp()
    EspEnabled = not EspEnabled
    setButtonState(EspBtn, EspEnabled)

    if EspEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            setupPlayer(player)
        end

        espConnections.playerAdded = Players.PlayerAdded:Connect(function(player)
            setupPlayer(player)
        end)

        espConnections.playerRemoving = Players.PlayerRemoving:Connect(function(player)
            if espConnections[player] then
                espConnections[player]:Disconnect()
                espConnections[player] = nil
            end
            if player.Character then
                removeHighlight(player.Character)
            end
        end)
    else
        for char, hl in pairs(highlights) do
            if hl then hl:Destroy() end
        end
        highlights = {}

        for key, conn in pairs(espConnections) do
            if typeof(conn) == "RBXScriptConnection" then
                conn:Disconnect()
            end
        end
        espConnections = {}
    end
end

EspBtn.MouseButton1Click:Connect(toggleEsp)

