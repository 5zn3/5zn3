local function createTab(name, text, index)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "Tab"
    btn.BackgroundTransparency = 1
    btn.Position = UDim2.new(index * 0.3333, 0, 0, 0)
    btn.Size = UDim2.new(0.3333, 0, 1, 0)
    btn.ZIndex = 5
    btn.AutoButtonColor = false
    btn.Text = ""
    btn.Parent = TabBar

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.ZIndex = 6
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = text
    lbl.TextColor3 = Colors.TEXT_MUTED
    lbl.TextSize = 11
    lbl.Parent = btn

    TabLabels[index + 1] = lbl
    TabButtons[index + 1] = btn
    return btn
end

