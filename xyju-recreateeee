-- Helpers
local function mkSect(page, text, order)
    local f = Instance.new("Frame")
    f.BackgroundTransparency = 1
    f.Size = UDim2.new(1, 0, 0, 26)
    f.LayoutOrder = order
    f.Parent = page

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -8, 1, 0)
    lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.Font = Enum.Font.GothamBlack
    lbl.Text = text:upper()
    lbl.TextColor3 = Colors.ACCENT_LIGHT
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local line = Instance.new("Frame")
    line.BackgroundColor3 = Colors.ACCENT
    line.BackgroundTransparency = 0.4
    line.BorderSizePixel = 0
    line.Position = UDim2.new(0, 12, 1, -4)
    line.Size = UDim2.new(1, -24, 0, 1.5)
    line.Parent = f
    return f
end

local function mkRow(page, order)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = Colors.ROW_BG
    f.BackgroundTransparency = 0.3
    f.BorderSizePixel = 0
    f.Size = UDim2.new(1, -4, 0, 42)
    f.LayoutOrder = order
    f.Parent = page

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = f

    local s = Instance.new("UIStroke")
    s.Color = Colors.ROW_BORDER
    s.Thickness = 1
    s.Transparency = 0.5
    s.Parent = f

    f.MouseEnter:Connect(function()
        TweenService:Create(f, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45, 15, 15)}):Play()
    end)
    f.MouseLeave:Connect(function()
        TweenService:Create(f, TweenInfo.new(0.1), {BackgroundColor3 = Colors.ROW_BG}):Play()
    end)
    return f
end

local function mkLabel(row, text)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(0.55, 0, 1, 0)
    l.Position = UDim2.new(0, 12, 0, 0)
    l.Font = Enum.Font.GothamBold
    l.Text = text
    l.TextColor3 = Colors.TEXT
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = row
    return l
end

local function mkToggle(page, text, order, callback)
    local row = mkRow(page, order)
    mkLabel(row, text)

    local track = Instance.new("Frame")
    track.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    track.BackgroundTransparency = 0.2
    track.AnchorPoint = Vector2.new(0.5, 0.5)
    track.Position = UDim2.new(1, -48, 0.5, 0)
    track.Size = UDim2.new(0, 36, 0, 20)
    track.Parent = row

    local tc = Instance.new("UICorner")
    tc.CornerRadius = UDim.new(1, 0)
    tc.Parent = track

    local ts = Instance.new("UIStroke")
    ts.Color = Colors.ROW_BORDER
    ts.Thickness = 1
    ts.Transparency = 0.4
    ts.Parent = track

    local knob = Instance.new("Frame")
    knob.BackgroundColor3 = Color3.fromRGB(30, 12, 12)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Position = UDim2.new(0, 3, 0.5, 0)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Parent = track

    local kc = Instance.new("UICorner")
    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob

    local btn = Instance.new("TextButton")
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = track

    local state = false
    local function setVisual(on, silent)
        state = on
        TweenService:Create(track, TweenInfo.new(0.18), {
            BackgroundColor3 = on and Colors.ACCENT or Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = on and 0 or 0.2,
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.18), {
            Position = on and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
            BackgroundColor3 = on and Color3.fromRGB(255, 230, 230) or Color3.fromRGB(30, 12, 12),
        }):Play()
        TweenService:Create(ts, TweenInfo.new(0.18), {
            Color = on and Colors.ACCENT or Colors.ROW_BORDER,
            Transparency = on and 0.1 or 0.4,
        }):Play()
    end

    btn.MouseButton1Click:Connect(function()
        setVisual(not state)
        pcall(callback, state)
    end)

    return setVisual
end

