-- TP DOWN
local function teleportDown()
    local hrp = getHRP()
    if not hrp then return end
    local ray = workspace:Raycast(hrp.Position + Vector3.new(0, 2, 0), Vector3.new(0, -1000, 0))
    if ray then
        local hum = getHum()
        local off = (hum and hum.HipHeight or 2) + (hrp.Size.Y / 2)
        hrp.CFrame = CFrame.new(hrp.Position.X, ray.Position.Y + off, hrp.Position.Z)
        hrp.Velocity = Vector3.zero
    end
end

-- DROP
local dropActive = false
local function doDrop()
    if dropActive then return end
    local root = getHRP()
    if not root then return end
    dropActive = true
    local startTime = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local r = getHRP()
        if not r then conn:Disconnect(); dropActive = false; return end
        if tick() - startTime >= 0.4 then
            conn:Disconnect()
            local ray = workspace:Raycast(r.Position, Vector3.new(0, -1000, 0))
            if ray then
                local hum = getHum()
                local off = (hum and hum.HipHeight or 2) + (r.Size.Y / 2)
                r.CFrame = CFrame.new(r.Position.X, ray.Position.Y + off, r.Position.Z)
                r.Velocity = Vector3.zero
            end
            dropActive = false
            return
        end
        r.Velocity = Vector3.new(r.Velocity.X, 150, r.Velocity.Z)
    end)
end

-- ANTI RAGDOLL
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = getHum()
    local root = getHRP()
    if hum then
        local s = hum:GetState()
        if s == Enum.HumanoidStateType.Physics or s == Enum.HumanoidStateType.Ragdoll or s == Enum.HumanoidStateType.FallingDown then
            hum:ChangeState(Enum.HumanoidStateType.Running)
            if root then
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
            end
        end
    end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Motor6D") and not obj.Enabled then obj.Enabled = true end
    end
end)

