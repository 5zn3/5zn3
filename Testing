-- ======== STEAL ========
local function isMyPlotByName(name)
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return false end
    local plot = plots:FindFirstChild(name)
    if not plot then return false end
    local sign = plot:FindFirstChild("PlotSign")
    if sign then
        local yb = sign:FindFirstChild("YourBase")
        if yb and yb:IsA("BillboardGui") and yb.Enabled == true then
            return true
        end
    end
    return false
end

local function findStealPrompt()
    local hrp = getHRP()
    if not hrp then return nil end
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, plot in pairs(plots:GetChildren()) do
        if not plot:IsA("Model") then continue end
        if isMyPlotByName(plot.Name) then continue end
        local pods = plot:FindFirstChild("AnimalPodiums")
        if not pods then continue end
        for _, pod in pairs(pods:GetChildren()) do
            local base = pod:FindFirstChild("Base")
            local spawn = base and base:FindFirstChild("Spawn")
            if spawn then
                local att = spawn:FindFirstChild("PromptAttachment")
                if att then
                    for _, prompt in pairs(att:GetChildren()) do
                        if prompt:IsA("ProximityPrompt") and prompt.Enabled and prompt.ActionText == "Steal" then
                            local dist = (hrp.Position - spawn.Position).Magnitude
                            if dist < nearestDist and dist <= 20 then
                                nearestDist = dist
                                nearest = prompt
                            end
                        end
                    end
                end
            end
        end
    end
    return nearest
end

local stealCooldown = false
local function executeSteal(prompt)
    if stealCooldown or not prompt then return end
    stealCooldown = true
    pcall(function()
        if getconnections then
            for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
                if c.Function then task.spawn(c.Function) end
            end
            task.wait(1.3)
            for _, c in ipairs(getconnections(prompt.Triggered)) do
                if c.Function then task.spawn(c.Function) end
            end
        else
            prompt:InputHoldBegin()
            task.wait(1.3)
            prompt:InputHoldEnd()
        end
    end)
    task.wait(1.0)
    stealCooldown = false
end

local autoStealConn
local function startAutoSteal()
    if autoStealConn then return end
    autoStealConn = RunService.Heartbeat:Connect(function()
        if state.autoSteal and not stealCooldown then
            local p = findStealPrompt()
            if p then executeSteal(p) end
        end
    end)
end
local function stopAutoSteal()
    if autoStealConn then autoStealConn:Disconnect(); autoStealConn = nil end
end

-- ======== AUTO LEFT ========
local L_START = Vector3.new(-474.7, -5.9, 91.0)
local L_END = Vector3.new(-483.4, -3.9, 97.3)
local L_BACK = Vector3.new(-474.7, -5.9, 91.0)
local L_RETURN = Vector3.new(-472.31, -7.09, 26.70)
local L_FINAL = Vector3.new(-482.74, -5.13, 24.12)

local leftConn, waitingPhase, waitStart, waitSide
local function startAutoLeft()
    if leftConn then leftConn:Disconnect() end
    local phase = 1
    leftConn = RunService.Heartbeat:Connect(function()
        if not state.autoLeft then return end
        local hrp, hum = getHRP(), getHum()
        if not hrp or not hum then return end
        if waitingPhase and waitSide == "LEFT" then
            if tick() - waitStart >= 1.3 then
                waitingPhase = false
                waitSide = ""
                phase = 4
            end
            return
        end
        if phase == 1 then
            if (L_START - hrp.Position).Magnitude < 2.5 then phase = 2
            else moveToPoint(L_START, 59) end
        elseif phase == 2 then
            if (L_END - hrp.Position).Magnitude < 2.5 then
                waitingPhase = true
                waitStart = tick()
                waitSide = "LEFT"
                phase = 3
                hum.WalkSpeed = 59
                hum:MoveTo(hrp.Position)
                local p = findStealPrompt()
                if p then executeSteal(p) end
            else moveToPoint(L_END, 29) end
        elseif phase == 4 then
            if (L_BACK - hrp.Position).Magnitude < 2.5 then phase = 5
            else moveToPoint(L_BACK, 29) end
        elseif phase == 5 then
            if (L_RETURN - hrp.Position).Magnitude < 2.5 then phase = 6
            else moveToPoint(L_RETURN, 29) end
        elseif phase == 6 then
            if (L_FINAL - hrp.Position).Magnitude < 2.5 then
                state.autoLeft = false
                phase = 1
                if leftConn then leftConn:Disconnect(); leftConn = nil end
                hum.WalkSpeed = 59
                btnAutoLeft.BackgroundColor3 = Color3.fromRGB(47, 47, 47)
            else moveToPoint(L_FINAL, 29) end
        end
    end)
end
local function stopAutoLeft()
    if leftConn then leftConn:Disconnect(); leftConn = nil end
    waitingPhase = false
    waitSide = ""
    local hum = getHum()
    if hum then hum:MoveTo(Vector3.zero); hum.WalkSpeed = 59 end
end

