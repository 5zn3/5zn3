-- Конвертация
local function convertText(text)
    if not convertEnabled then return text end
    local lowerText = text:lower()
    for trigger, replacement in pairs(convertRules) do
        if lowerText:find(trigger:lower(), 1, true) then
            return replacement
        end
    end
    return text
end

