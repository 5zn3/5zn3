-- ======== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ========
local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- ======== ФУНКЦИЯ ДВИЖЕНИЯ С ПРИНУДИТЕЛЬНОЙ СКОРОСТЬЮ ========
local function moveToPoint(point)
    local hum = getHum()
    local root = getHRP()
    if hum and root then
        local currentSpeed = hum.WalkSpeed  -- Берём текущую скорость
        hum:MoveTo(point)
        -- Принудительно задаём скорость через Velocity
        local direction = (point - root.Position).Unit
        if direction.Magnitude > 0 then
            root.AssemblyLinearVelocity = Vector3.new(direction.X * currentSpeed, root.AssemblyLinearVelocity.Y, direction.Z * currentSpeed)
        end
    end
end

