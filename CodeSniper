local statusLabel = createLabel("Status: Waiting...", 0.7)

-- ============================================
--  ЛОГИКА
-- ============================================
local autoEnterEnabled = false
local submitAfterCount = 3
local collecting = false
local collectBuf = {}
local collectRemain = 0
local lastText = ""

local function typeCode(code)
    if not autoEnterEnabled then return end
    pcall(function()
        local Codes = PlayerGui:FindFirstChild("Codes")
        if Codes then
            local CodesInner = Codes:FindFirstChild("Codes")
            if CodesInner then
                local codeRedeem = CodesInner:FindFirstChild("CodeRedeem")
                if codeRedeem then
                    local textBox = codeRedeem:FindFirstChild("TextBox")
                    if textBox then
                        textBox.Text = code
                        textBox:CaptureFocus()
                        textBox:ReleaseFocus(true)
                        textBox.CursorPosition = #code
                        statusLabel.Text = "✅ Inserted: " .. code
                    end
                end
            end
        end
    end)
end

local function pressRedeem()
    pcall(function()
        local Codes = PlayerGui:FindFirstChild("Codes")
        if Codes then
            local CodesInner = Codes:FindFirstChild("Codes")
            if CodesInner then
                local confirm = CodesInner:FindFirstChild("Confirm")
                if confirm then
                    local button = confirm:FindFirstChildOfClass("TextButton")
                    if not button then
                        button = confirm:FindFirstChildOfClass("ImageButton")
                    end
                    if not button then
                        button = confirm:FindFirstChildWhichIsA("TextButton")
                    end
                    if not button then
                        button = confirm
                    end
                    if button then
                        if firesignal then
                            pcall(function()
                                firesignal(button.MouseButton1Click)
                                firesignal(button.Activated)
                            end)
                        end
                        pcall(function()
                            button:CaptureFocus()
                            task.wait(0.05)
                            button:ReleaseFocus(true)
                        end)
                        statusLabel.Text = "✅ Redeem pressed"
                    end
                end
            end
        end
    end)
end

local function dispatch(text)
    if not autoEnterEnabled then return end
    if not text or text == "" then return end
    if text == lastText then return end
    lastText = text
    statusLabel.Text = "📩 Received: " .. text

    if submitAfterCount > 1 then
        if collecting then
            table.insert(collectBuf, text)
            collectRemain = collectRemain - 1
            if collectRemain <= 0 then
                local result = table.concat(collectBuf, "")
                typeCode(result)
                task.wait(0.3)
                pressRedeem()
                collecting = false
                collectBuf = {}
                collectRemain = 0
            end
        else
            collecting = true
            collectBuf = {}
            collectRemain = submitAfterCount
            table.insert(collectBuf, text)
            collectRemain = collectRemain - 1
            if collectRemain <= 0 then
                local result = table.concat(collectBuf, "")
                typeCode(result)
                task.wait(0.3)
                pressRedeem()
                collecting = false
                collectBuf = {}
                collectRemain = 0
            end
        end
    else
        typeCode(text)
        task.wait(0.3)
        pressRedeem()
    end
end

local function watchNotifications()
    local target = player.PlayerGui:FindFirstChild("TopNotification")
    if not target then
        statusLabel.Text = "❌ TopNotification not found"
        return
    end
    local topNotif = target:FindFirstChild("TopNotification")
    if not topNotif then
        statusLabel.Text = "❌ TopNotification.TopNotification not found"
        return
    end
    statusLabel.Text = "👀 Watching for codes..."

    topNotif.ChildAdded:Connect(function(child)
        if child:IsA("TextLabel") and child.Name == "Template" then
            task.wait(0.05)
            local text = child.Text
            if text and text ~= "" then
                dispatch(text)
            end
        end
    end)
end

watchNotifications()

-- ============================================
--  DRAG
-- ============================================
local dragging = false
local dragStart, startPos

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end)

print("✅ Code Sniper loaded!")

end) -- pcall

