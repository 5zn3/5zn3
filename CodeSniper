-- ======== ФУНКЦИЯ ОБНОВЛЕНИЯ ГРАДИЕНТА ========
local function updateButtonGradient(btn, isOn)
    if isOn then
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        btn.Text = "ON"
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        local grad = btn:FindFirstChild("UIGradient")
        if grad then
            grad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0.000, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(1.000, Color3.fromRGB(0, 200, 0))
            }
        end
    else
        btn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        btn.Text = "OFF"
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        local grad = btn:FindFirstChild("UIGradient")
        if grad then
            grad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 93, 93)),
                ColorSequenceKeypoint.new(1.000, Color3.fromRGB(119, 0, 0))
            }
        end
    end
end

-- ======== AUTO LEFT ========
local leftConn = nil
local function startAutoLeft()
    if leftConn then leftConn:Disconnect() end
    local phase = 1
    leftConn = RunService.Heartbeat:Connect(function()
        if not state.autoLeft then return end
        local hrp = getHRP()
        local hum = getHum()
        if not hrp or not hum then return end

        if phase == 1 then
            if (L_START - hrp.Position).Magnitude < 2.5 then
                phase = 2
            else
                moveToPoint(L_START)
            end
        elseif phase == 2 then
            if (L_END - hrp.Position).Magnitude < 2.5 then
                phase = 3
            else
                moveToPoint(L_END)
            end
        elseif phase == 3 then
            if (L_BACK - hrp.Position).Magnitude < 2.5 then
                phase = 4
            else
                moveToPoint(L_BACK)
            end
        elseif phase == 4 then
            if (L_RETURN - hrp.Position).Magnitude < 2.5 then
                phase = 5
            else
                moveToPoint(L_RETURN)
            end
        elseif phase == 5 then
            if (L_FINAL - hrp.Position).Magnitude < 2.5 then
                state.autoLeft = false
                phase = 1
                if leftConn then leftConn:Disconnect(); leftConn = nil end
                updateButtonGradient(G2L["a"], false)
            else
                moveToPoint(L_FINAL)
            end
        end
    end)
end

local function stopAutoLeft()
    if leftConn then leftConn:Disconnect(); leftConn = nil end
    local hum = getHum()
    local root = getHRP()
    if hum then hum:MoveTo(Vector3.zero) end
    if root then root.AssemblyLinearVelocity = Vector3.zero end
    updateButtonGradient(G2L["a"], false)
end

