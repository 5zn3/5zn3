local player = game:GetService("Players").LocalPlayer
local UserInputService = game:GetService("UserInputService")

local screenGui = G2L["1"]
local mainFrame = G2L["2"]
local toggleButton = G2L["a"]

local autoTypeEnabled = false
local lastWord = ""

local function updateButton()
    if autoTypeEnabled then
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        toggleButton.Text = "ON"
        toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    else
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        toggleButton.Text = "OFF"
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

toggleButton.MouseButton1Click:Connect(function()
    autoTypeEnabled = not autoTypeEnabled
    updateButton()
end)

local function typeToTextBox(text)
    if not autoTypeEnabled then return false end
    if not text or text == "" then return false end
    
    pcall(function()
        local codes = player.PlayerGui:FindFirstChild("Codes")
        if codes then
            local codesFolder = codes:FindFirstChild("Codes")
            if codesFolder then
                local redeem = codesFolder:FindFirstChild("CodeRedeem")
                if redeem then
                    local textBox = redeem:FindFirstChild("TextBox")
                    if textBox then
                        local current = textBox.Text or ""
                        if current == "" then
                            textBox.Text = text
                        elseif not string.find(current, text) then
                            textBox.Text = current .. text
                        end
                    end
                end
            end
        end
    end)
end

local function findNotificationText()
    local success, result = pcall(function()
        local target = player.PlayerGui:FindFirstChild("TopNotification")
        if target then
            local topNotif = target:FindFirstChild("TopNotification")
            if topNotif then
                local templates = {}
                for _, child in ipairs(topNotif:GetChildren()) do
                    if child:IsA("TextLabel") and child.Name == "Template" then
                        table.insert(templates, child)
                    end
                end
                if #templates > 0 then
                    local lastTemplate = templates[#templates]
                    return lastTemplate.Text
                end
            end
        end
        return nil
    end)
    if success and result and result ~= "" then
        return result
    end
    return nil
end

task.spawn(function()
    while screenGui and screenGui.Parent do
        task.wait(0.15)
        local text = findNotificationText()
        if text then
            text = text:gsub("^%s+", ""):gsub("%s+$", "")
            if text ~= "" and text ~= " " and text ~= "WAITING..." then
                if text ~= lastWord then
                    lastWord = text
                    typeToTextBox(text)
                end
            end
        end
    end
end)

local dragging = false
local dragStart = nil
local startPos = nil

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

return G2L["1"], require;
