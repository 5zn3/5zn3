    local target = player.PlayerGui:FindFirstChild("TopNotification")
    if not target then 
        print("[Code Sniper] ❌ TopNotification не найдена!")
        return 
    end
    
    local topNotif = target:FindFirstChild("TopNotification")
    if not topNotif then 
        print("[Code Sniper] ❌ TopNotification.TopNotification не найдена!")
        return 
    end
    
    print("[Code Sniper] ✅ Слежение за уведомлениями запущено!")
    
    -- Проверяем уже существующие уведомления
    for _, child in ipairs(topNotif:GetChildren()) do
        if child:IsA("TextLabel") and child.Name == "Template" then
            print("[Code Sniper] 📝 Найдено существующее уведомление: " .. child.Text)
