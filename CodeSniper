local autoEnterEnabled = false
local autoReplaceEnabled = false
local submitAfterCount = 3

local function updateSlider(btn, state)
    if state then
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        btn.Text = "O"
    else
        btn.BackgroundColor3 = Color3.fromRGB(199, 0, 0)
        btn.Text = "O"
    end
end

autoBtn.MouseButton1Click:Connect(function()
    autoEnterEnabled = not autoEnterEnabled
    updateSlider(autoBtn, autoEnterEnabled)
end)

repAutoBtn.MouseButton1Click:Connect(function()
    autoReplaceEnabled = not autoReplaceEnabled
    updateSlider(repAutoBtn, autoReplaceEnabled)
end)

subBox.FocusLost:Connect(function()
    local n = tonumber(subBox.Text) or 3
    if n < 1 then n = 1 end
    submitAfterCount = n
    subBox.Text = tostring(n)
end)

local function getTriggers()
    local triggers = {}
    for i = 1, 5 do
        local box = triggerBoxes[i]
        if box and box.Text and box.Text ~= "" then
            table.insert(triggers, box.Text:lower())
        end
    end
    return triggers
end

local function getReplaceRules()
    local rules = {}
    for i = 1, 5 do
        local from = replaceFrom[i]
        local to = replaceTo[i]
        if from and to and from.Text ~= "" and to.Text ~= "" then
            rules[from.Text:lower()] = to.Text
        end
    end
    return rules
end

local function convertText(text)
    if not autoReplaceEnabled then return text end
    local rules = getReplaceRules()
    local lowerText = text:lower()
    for trigger, replacement in pairs(rules) do
        if lowerText:find(trigger:lower(), 1, true) then
            return replacement
        end
    end
    return text
end

local function typeCode(code)
    if not autoEnterEnabled then return end
    pcall(function()
        local Codes = PlayerGui:FindFirstChild("Codes")
        if Codes then
            local CodesInner = Codes:FindFirstChild("Codes")
            if CodesInner then
                local codeRedeem = CodesInner:FindFirstChild("CodeRedeem")
                if codeRedeem then
                    local textBox = codeRedeem:FindFirstChild("TextBox")
                    if textBox then
                        textBox.Text = code
                        textBox:CaptureFocus()
                        textBox:ReleaseFocus(true)
                        textBox.CursorPosition = #code
                    end
                end
            end
        end
    end)
end

local function pressRedeem()
    pcall(function()
        local Codes = PlayerGui:FindFirstChild("Codes")
        if Codes then
            local CodesInner = Codes:FindFirstChild("Codes")
            if CodesInner then
                local confirm = CodesInner:FindFirstChild("Confirm")
                if confirm then
                    local button = confirm:FindFirstChildWhichIsA("TextButton") or confirm
                    if button then
                        firesignal(button.MouseButton1Click)
                        firesignal(button.Activated)
                    end
                end
            end
        end
    end)
end

local function findNotificationText()
    local success, result = pcall(function()
        local target = player.PlayerGui:FindFirstChild("TopNotification")
        if target then
            local topNotif = target:FindFirstChild("TopNotification")
            if topNotif then
                for _, child in ipairs(topNotif:GetChildren()) do
                    if child:IsA("TextLabel") and child.Name == "Template" then
                        return child.Text
                    end
                end
            end
        end
        return nil
    end)
    if success and result and result ~= "" then
        return result
    end
    return nil
end

-- ============================================
--  ОБРАБОТКА УВЕДОМЛЕНИЙ
-- ============================================
local collecting = false
local collectBuf = {}
local collectRemain = 0
local lastText = ""

local function dispatch(text)
    if not autoEnterEnabled then return end
    if not text or text == "" then return end
    if text == lastText then return end
    lastText = text

    local triggers = getTriggers()
    local matched = #triggers == 0
    if not matched then
        local lowerText = text:lower()
        for _, trigger in ipairs(triggers) do
            if lowerText:find(trigger, 1, true) then
                matched = true
                break
            end
        end
    end
    if not matched then return end

    local converted = convertText(text)
    
    if submitAfterCount > 1 then
        if collecting then
            table.insert(collectBuf, converted)
            collectRemain = collectRemain - 1
            if collectRemain <= 0 then
                local result = table.concat(collectBuf, "")
                if result ~= "" then
                    typeCode(result)
                    task.wait(0.3)
                    pressRedeem()
                end
                collecting = false
                collectBuf = {}
                collectRemain = 0
            end
        else
            collecting = true
            collectBuf = {}
            collectRemain = submitAfterCount
            table.insert(collectBuf, converted)
            collectRemain = collectRemain - 1
            if collectRemain <= 0 then
                local result = table.concat(collectBuf, "")
                if result ~= "" then
                    typeCode(result)
                    task.wait(0.3)
                    pressRedeem()
                end
                collecting = false
                collectBuf = {}
                collectRemain = 0
            end
        end
    else
        typeCode(converted)
        task.wait(0.3)
        pressRedeem()
    end
end

local function watchNotifications()
    local target = player.PlayerGui:FindFirstChild("TopNotification")
    if not target then return
    local topNotif = target:FindFirstChild("TopNotification")
    if not topNotif then return
    topNotif.ChildAdded:Connect(function(child)
        if child:IsA("TextLabel") and child.Name == "Template" then
            task.wait(0.05)
            local text = child.Text
            if text and text ~= "" then
                dispatch(text)
            end
        end
    end)
end
watchNotifications()

-- ============================================
--  DRAG (перетаскивание)
-- ============================================
local dragging = false
local dragStart, startPos

Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end)

