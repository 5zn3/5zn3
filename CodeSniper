--  СЛЕЖЕНИЕ ЗА УВЕДОМЛЕНИЯМИ (ИСПРАВЛЕНО)
-- ============================================
local function dispatch(text)
    print("[Code Sniper] dispatch вызван с текстом: " .. text)
    
    if not autoTypeEnabled then 
        print("[Code Sniper] Auto Type выключен, пропускаем")
        return 
    end
    
    if not text or text == "" then 
        print("[Code Sniper] Текст пустой, пропускаем")
        return 
    end

    local converted = convertText(text)
    print("[Code Sniper] После конвертации: " .. converted)
    
    if captureCount > 0 then
        if collecting then
            table.insert(collectBuf, converted)
            collectRemain = collectRemain - 1
            print("[Code Sniper] Сбор: " .. table.concat(collectBuf) .. " (осталось " .. collectRemain .. ")")
            if collectRemain <= 0 then
                local result = table.concat(collectBuf)
                if result ~= "" then
                    typeCode(result)
                    if autoRedeemEnabled then
                        pressRedeem()
                    end
                end
                collecting = false
                collectBuf = {}
                collectRemain = 0
            end
        else
            collecting = true
            collectBuf = {}
            collectRemain = captureCount
            table.insert(collectBuf, converted)
            collectRemain = collectRemain - 1
            print("[Code Sniper] Начат сбор: " .. table.concat(collectBuf) .. " (осталось " .. collectRemain .. ")")
            if collectRemain <= 0 then
                local result = table.concat(collectBuf)
                if result ~= "" then
                    typeCode(result)
                    if autoRedeemEnabled then
                        pressRedeem()
                    end
                end
                collecting = false
                collectBuf = {}
                collectRemain = 0
            end
        end
    else
        if converted ~= "" then
            typeCode(converted)
            if autoRedeemEnabled then
                pressRedeem()
            end
        end
    end
end

