-- ПЕРЕТАСКИВАНИЕ
local UserInputService = game:GetService("UserInputService")
local dragging = false
local dragStart = nil
local startPos = nil

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ФУНКЦИЯ КОПИРОВАНИЯ
local function CopyToClipboard(text)
    if text and text ~= "" and text ~= "WAITING..." and text ~= "Ожидание..." then
        local success, err = pcall(function()
            setclipboard(text)
        end)
        
        if success then
            CopyStatus.Text = "OK!"
            CopyStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
            CopyStatus.BorderColor3 = Color3.fromRGB(0, 255, 0)
            CopyStatus.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            
            -- Мигаем зеленым
            task.wait(0.5)
            CopyStatus.Text = "ON"
            CopyStatus.TextColor3 = Color3.fromRGB(0, 255, 0)
            CopyStatus.BorderColor3 = Color3.fromRGB(0, 200, 0)
            CopyStatus.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        else
            CopyStatus.Text = "ERROR"
            CopyStatus.TextColor3 = Color3.fromRGB(255, 0, 0)
            CopyStatus.BorderColor3 = Color3.fromRGB(255, 0, 0)
            CopyStatus.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        end
    else
        CopyStatus.Text = "EMPTY"
        CopyStatus.TextColor3 = Color3.fromRGB(255, 200, 0)
        CopyStatus.BorderColor3 = Color3.fromRGB(255, 200, 0)
        CopyStatus.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    end
end

-- ПОИСК ТЕКСТА
local function FindAndCopy()
    local player = game:GetService("Players").LocalPlayer
    local foundText = nil
    
    -- Ищем наш текст
    local success, result = pcall(function()
        local target = player.PlayerGui:FindFirstChild("TopNotification")
        if target then
            local topNotif = target:FindFirstChild("TopNotification")
            if topNotif then
                local template = topNotif:FindFirstChild("Template")
                if template and template:IsA("TextLabel") then
                    return template.Text
                end
            end
        end
        return nil
    end)
    
    if success and result and result ~= "" then
        foundText = result:gsub("^%s+", ""):gsub("%s+$", "")
        if foundText ~= "" then
            CurrentWordDisplay.Text = foundText
            CurrentWordDisplay.TextColor3 = Color3.fromRGB(255, 255, 255)
            CopyToClipboard(foundText)
            return true
        end
    end
    
    CurrentWordDisplay.Text = "WAITING..."
    CurrentWordDisplay.TextColor3 = Color3.fromRGB(255, 255, 255)
    return false
end

-- НАСТРОЙКА КНОПОК
CopyButton.MouseButton1Click:Connect(function()
    local currentText = CurrentWordDisplay.Text
    if currentText ~= "WAITING..." and currentText ~= "" then
        CopyToClipboard(currentText)
    else
        FindAndCopy()
    end
end)

CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- ОСНОВНОЙ ЦИКЛ (каждые 0.5 сек)
task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        task.wait(0.5)
        local success = pcall(function()
            return game:GetService("Players").LocalPlayer.PlayerGui
        end)
        if success then
            FindAndCopy()
        end
    end
end)
